<Window x:Class="ViewCraft.Views.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Convert &amp; Process — ViewCraft" 
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#18181b" Foreground="#f4f4f5"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#d4d4d8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Batch Image Processor" FontSize="20" FontWeight="Bold" Foreground="#f59e0b"/>
            <TextBlock x:Name="TxtItemCount" Text="Selected: 0 images" Foreground="#a1a1aa" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Target Format & Quality -->
        <Border Grid.Row="1" Background="#242427" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Target Format:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbFormat" SelectedIndex="0">
                        <ComboBoxItem Content="WebP (Modern &amp; Compact)"/>
                        <ComboBoxItem Content="JPEG (Universal Photo)"/>
                        <ComboBoxItem Content="PNG (Lossless Transparency)"/>
                        <ComboBoxItem Content="AVIF (Next-Gen High Efficiency)"/>
                        <ComboBoxItem Content="TIFF (High Bit-Depth Archive)"/>
                        <ComboBoxItem Content="BMP (Uncompressed Bitmap)"/>
                        <ComboBoxItem Content="ICO (Windows Icon)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Quality:" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtQualityVal" Text="90%" HorizontalAlignment="Right" Foreground="#f59e0b" FontWeight="Bold"/>
                    </DockPanel>
                    <Slider x:Name="SldQuality" Minimum="1" Maximum="100" Value="90" ValueChanged="SldQuality_ValueChanged" TickFrequency="5" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Resize Options -->
        <Border Grid.Row="2" Background="#242427" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="ChkResize" Content="Resize Images (Fit into bounding box, preserve aspect ratio)" Foreground="#fafafa" FontWeight="SemiBold" Checked="ChkResize_Changed" Unchecked="ChkResize_Changed"/>
                <Grid x:Name="GridResize" Margin="0,10,0,0" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Max Width (px):" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMaxWidth" Text="1920"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Max Height (px):" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMaxHeight" Text="1080"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Output Directory -->
        <Border Grid.Row="3" Background="#242427" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Destination Folder:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtOutputDir" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseOutput_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Progress Area -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,4">
                <TextBlock x:Name="TxtProgressStatus" Text="Ready to process." Foreground="#a1a1aa"/>
                <TextBlock x:Name="TxtProgressPercent" Text="0%" HorizontalAlignment="Right" Foreground="#f59e0b" FontWeight="Bold"/>
            </DockPanel>
            <ProgressBar x:Name="PrgProgress" Height="10" Minimum="0" Maximum="100" Value="0" Background="#27272a" Foreground="#f59e0b" BorderBrush="#3f3f46"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnCancel" Content="Close" Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnStart" Content="Start Batch Conversion" Background="#f59e0b" Foreground="#18181b" FontWeight="Bold" BorderThickness="0" Click="BtnStart_Click"/>
        </StackPanel>
    </Grid>
</Window>
