<Window x:Class="ViewCraft.Views.CropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop Image &amp; Aspect Ratio — ViewCraft" 
        Height="720" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#18181b" Foreground="#f4f4f5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Aspect Ratio Toolbar -->
        <Border Grid.Row="0" Background="#242427" BorderBrush="#3f3f46" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Aspect Ratio:" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <RadioButton x:Name="RbFree" Content="Freeform" IsChecked="True" Foreground="#fafafa" Margin="0,0,12,0" VerticalAlignment="Center" Checked="AspectRatio_Changed"/>
                    <RadioButton x:Name="Rb1x1" Content="1:1 (Square)" Foreground="#fafafa" Margin="0,0,12,0" VerticalAlignment="Center" Checked="AspectRatio_Changed"/>
                    <RadioButton x:Name="Rb16x9" Content="16:9 (Landscape)" Foreground="#fafafa" Margin="0,0,12,0" VerticalAlignment="Center" Checked="AspectRatio_Changed"/>
                    <RadioButton x:Name="Rb9x16" Content="9:16 (Portrait)" Foreground="#fafafa" Margin="0,0,12,0" VerticalAlignment="Center" Checked="AspectRatio_Changed"/>
                    <RadioButton x:Name="Rb4x3" Content="4:3" Foreground="#fafafa" Margin="0,0,12,0" VerticalAlignment="Center" Checked="AspectRatio_Changed"/>
                    <RadioButton x:Name="Rb3x2" Content="3:2 (DSLR)" Foreground="#fafafa" Margin="0,0,12,0" VerticalAlignment="Center" Checked="AspectRatio_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Reset Crop" Padding="12,4" Background="#27272a" Foreground="#fafafa" BorderBrush="#3f3f46" Margin="0,0,10,0" Click="BtnReset_Click"/>
                    <Button Content="Cancel" Padding="12,4" Background="#27272a" Foreground="#fafafa" BorderBrush="#3f3f46" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button Content="✓ Apply Crop" Padding="16,4" Background="#f59e0b" Foreground="#18181b" FontWeight="Bold" BorderThickness="0" Click="BtnApply_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Interactive Crop Area -->
        <Grid Grid.Row="1" Background="#111113" ClipToBounds="True">
            <Viewbox x:Name="ViewboxCropHost" Stretch="Uniform">
                <Grid x:Name="GridCanvas" Width="1000" Height="700">
                    <!-- Base Image -->
                    <Image x:Name="ImgPreview" Stretch="Fill"/>

                    <!-- Dark Dimmer Overlay Outside Crop -->
                    <Path x:Name="PathDimmer" Fill="#99000000"/>

                    <!-- Interactive Crop Rectangle -->
                    <Canvas x:Name="CanvasCropOverlay" 
                            MouseDown="CanvasCrop_MouseDown" 
                            MouseMove="CanvasCrop_MouseMove" 
                            MouseUp="CanvasCrop_MouseUp">
                        <Rectangle x:Name="RectCrop" 
                                   Stroke="#f59e0b" 
                                   StrokeThickness="2" 
                                   Fill="Transparent" 
                                   Cursor="SizeAll"/>

                        <!-- Rule of Thirds Grid Lines -->
                        <Line x:Name="LineGridH1" Stroke="#80f59e0b" StrokeThickness="1" StrokeDashArray="2,2"/>
                        <Line x:Name="LineGridH2" Stroke="#80f59e0b" StrokeThickness="1" StrokeDashArray="2,2"/>
                        <Line x:Name="LineGridV1" Stroke="#80f59e0b" StrokeThickness="1" StrokeDashArray="2,2"/>
                        <Line x:Name="LineGridV2" Stroke="#80f59e0b" StrokeThickness="1" StrokeDashArray="2,2"/>

                        <!-- Resize Handles (Corners) -->
                        <Rectangle x:Name="HandleNW" Width="10" Height="10" Fill="#f59e0b" Stroke="#ffffff" StrokeThickness="1" Cursor="SizeNWSE"/>
                        <Rectangle x:Name="HandleNE" Width="10" Height="10" Fill="#f59e0b" Stroke="#ffffff" StrokeThickness="1" Cursor="SizeNESW"/>
                        <Rectangle x:Name="HandleSW" Width="10" Height="10" Fill="#f59e0b" Stroke="#ffffff" StrokeThickness="1" Cursor="SizeNESW"/>
                        <Rectangle x:Name="HandleSE" Width="10" Height="10" Fill="#f59e0b" Stroke="#ffffff" StrokeThickness="1" Cursor="SizeNWSE"/>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Bottom Crop Readout Bar -->
        <Border Grid.Row="2" Background="#242427" BorderBrush="#3f3f46" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="TxtCropDimensions" Text="Cropped Size: — × — px" Foreground="#f59e0b" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="Drag the box to move, drag corners to resize, or pick aspect ratio above." Foreground="#a1a1aa" HorizontalAlignment="Right" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
