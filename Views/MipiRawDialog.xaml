<Window x:Class="ViewCraft.Views.MipiRawDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open MIPI RAW / Sensor Dump — ViewCraft" 
        Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#18181b" Foreground="#f4f4f5"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#d4d4d8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="MIPI CSI-2 RAW / Sensor Dump Importer" FontSize="20" FontWeight="Bold" Foreground="#f59e0b"/>
            <TextBlock x:Name="TxtFileInfo" Text="File: — | Size: —" Foreground="#a1a1aa" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Settings & Live Preview Grid -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Form Controls -->
            <StackPanel Grid.Column="0">
                <!-- Auto-Detected Resolution -->
                <TextBlock Text="Auto-Detected Geometry:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbPresetResolution" Margin="0,0,0,12" SelectionChanged="CmbPresetResolution_SelectionChanged"/>

                <!-- Custom Width & Height -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Width (px):" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtWidth" Text="1920" TextChanged="Params_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Height (px):" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtHeight" Text="1080" TextChanged="Params_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- Bit Packing Format -->
                <TextBlock Text="Bit Packing Format:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbFormat" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="Params_Changed">
                    <ComboBoxItem Content="MIPI RAW10 (Packed - 5 bytes/4 px)"/>
                    <ComboBoxItem Content="MIPI RAW12 (Packed - 3 bytes/2 px)"/>
                    <ComboBoxItem Content="RAW8 (Unpacked - 1 byte/px)"/>
                    <ComboBoxItem Content="RAW16 (16-bit Little Endian)"/>
                    <ComboBoxItem Content="RAW16 (16-bit Big Endian)"/>
                </ComboBox>

                <!-- Bayer CFA Pattern -->
                <TextBlock Text="Bayer CFA Pattern:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbPattern" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="Params_Changed">
                    <ComboBoxItem Content="RGGB (Most Sony / OmniVision sensors)"/>
                    <ComboBoxItem Content="BGGR"/>
                    <ComboBoxItem Content="GRBG"/>
                    <ComboBoxItem Content="GBRG"/>
                    <ComboBoxItem Content="Monochrome (Mono / IR sensor)"/>
                </ComboBox>

                <!-- Black Level & White Balance Gains -->
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Black Level:" Foreground="#d4d4d8"/>
                    <TextBlock x:Name="TxtBlackLevelVal" Text="64" Foreground="#f59e0b" HorizontalAlignment="Right" FontWeight="Bold"/>
                </DockPanel>
                <Slider x:Name="SldBlackLevel" Minimum="0" Maximum="256" Value="64" Margin="0,0,0,10" ValueChanged="SldBlackLevel_ValueChanged"/>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Red Gain (White Balance):" Foreground="#d4d4d8"/>
                    <TextBlock x:Name="TxtRedGainVal" Text="1.8" Foreground="#f59e0b" HorizontalAlignment="Right" FontWeight="Bold"/>
                </DockPanel>
                <Slider x:Name="SldRedGain" Minimum="0.5" Maximum="3.0" Value="1.8" Margin="0,0,0,10" ValueChanged="SldGain_ValueChanged"/>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Blue Gain (White Balance):" Foreground="#d4d4d8"/>
                    <TextBlock x:Name="TxtBlueGainVal" Text="1.5" Foreground="#f59e0b" HorizontalAlignment="Right" FontWeight="Bold"/>
                </DockPanel>
                <Slider x:Name="SldBlueGain" Minimum="0.5" Maximum="3.0" Value="1.5" Margin="0,0,0,10" ValueChanged="SldGain_ValueChanged"/>
            </StackPanel>

            <!-- Right Live Preview -->
            <Border Grid.Column="2" Background="#111113" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <Image x:Name="ImgLivePreview" Stretch="Uniform"/>
                    <Border VerticalAlignment="Bottom" Background="#B018181b" Padding="8,4">
                        <TextBlock x:Name="TxtPreviewStatus" Text="Live Demosaic Preview" Foreground="#a1a1aa" FontSize="11" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Open in ViewCraft" Background="#f59e0b" Foreground="#18181b" FontWeight="Bold" BorderThickness="0" Click="BtnOpen_Click"/>
        </StackPanel>
    </Grid>
</Window>
