<Window x:Class="ViewCraft.Views.CompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Split &amp; Side-by-Side Comparison — ViewCraft" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#18181b" Foreground="#f4f4f5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#242427" BorderBrush="#3f3f46" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#a1a1aa"/>
                    <RadioButton x:Name="RbSplit" Content="Split Wipe Slider (Before / After)" IsChecked="True" Foreground="#fafafa" Margin="0,0,16,0" VerticalAlignment="Center" Checked="CompareMode_Changed"/>
                    <RadioButton x:Name="RbSideBySide" Content="Side-by-Side (2-Up Synchronized)" Foreground="#fafafa" VerticalAlignment="Center" Checked="CompareMode_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Reset View" Padding="10,4" Background="#27272a" Foreground="#fafafa" BorderBrush="#3f3f46" Margin="0,0,8,0" Click="BtnResetView_Click"/>
                    <Button Content="Close" Padding="14,4" Background="#3f3f46" Foreground="#fafafa" BorderThickness="0" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Split Wipe Slider View -->
        <Grid x:Name="GridSplitView" Grid.Row="1" ClipToBounds="True" Background="#111113" SizeChanged="SplitView_SizeChanged">
            <!-- Background: "After" / Modified image -->
            <Image x:Name="ImgAfter" Stretch="Uniform"/>

            <!-- Overlay: "Before" / Original image clipped to slider position -->
            <Grid x:Name="GridBeforeContainer">
                <Image x:Name="ImgBefore" Stretch="Uniform"/>
            </Grid>

            <!-- Splitter Divider Line -->
            <Canvas x:Name="CanvasSplitter" IsHitTestVisible="False">
                <Line x:Name="LineSplitter" Stroke="#f59e0b" StrokeThickness="2" Y1="0" Y2="10000"/>
            </Canvas>

            <!-- Draggable Handle / Slider -->
            <Slider x:Name="SldSplitPosition" Minimum="0" Maximum="1" Value="0.5" 
                    VerticalAlignment="Bottom" Margin="40,0,40,20" 
                    ValueChanged="SldSplitPosition_ValueChanged"/>

            <!-- Labels -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Background="#B0000000" CornerRadius="4" Padding="8,4">
                <TextBlock Text="BEFORE (Original)" Foreground="#d4d4d8" FontSize="12" FontWeight="Bold"/>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Background="#B0000000" CornerRadius="4" Padding="8,4">
                <TextBlock Text="AFTER (Adjusted)" Foreground="#f59e0b" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- Side-by-Side View (2-Up) -->
        <Grid x:Name="GridSideBySideView" Grid.Row="1" Visibility="Collapsed" Background="#111113">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Image -->
            <Grid Grid.Column="0">
                <Image x:Name="ImgSideLeft" Stretch="Uniform"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="#B0000000" CornerRadius="4" Padding="8,4">
                    <TextBlock Text="IMAGE 1 (Original)" Foreground="#d4d4d8" FontSize="12" FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- Divider -->
            <Rectangle Grid.Column="1" Fill="#3f3f46"/>

            <!-- Right Image -->
            <Grid Grid.Column="2">
                <Image x:Name="ImgSideRight" Stretch="Uniform"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="#B0000000" CornerRadius="4" Padding="8,4">
                    <TextBlock Text="IMAGE 2 (Adjusted)" Foreground="#f59e0b" FontSize="12" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status -->
        <Border Grid.Row="2" Background="#242427" BorderBrush="#3f3f46" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="TxtCompareInfo" Text="Use slider below to wipe between Before and After images." Foreground="#a1a1aa" FontSize="12"/>
        </Border>
    </Grid>
</Window>
